<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/TrackBackGround">

    <LinearLayout
        style="@style/TrackLinearLayout"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:id="@+id/centerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            tools:ignore="UselessParent">

            <ImageView
                android:id="@+id/imageTrackPlaylist"
                style="@style/TrackImage"
                android:layout_marginStart="@dimen/margin_track"
                android:layout_marginTop="@dimen/top_search" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleTextPlaylistMediaTrack"
                    style="@style/TrackText"
                    android:layout_marginStart="@dimen/top_search"
                    android:layout_marginTop="@dimen/top"
                    android:ellipsize="end"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/listMediaTrack"
                    style="@style/TrackText"
                    android:layout_width="@dimen/track_width"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/top_search"
                    android:gravity="left"
                    android:textSize="@dimen/text_time" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>